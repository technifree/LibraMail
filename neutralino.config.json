{
  "applicationId": "eu.libramail.app",
  "version": "0.2.20",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.open",
    "os.showSaveDialog",
    "os.showOpenDialog",
    "window.*",
    "storage.*",
    "filesystem.readFile",
    "filesystem.readBinaryFile",
    "filesystem.writeFile"
  ],
  "modes": {
    "window": {
      "title": "LibraMail 0.2.20",
      "width": 1440,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "exitProcessOnClose": false,
      "icon": "/resources/favicon.ico"
    }
  },
  "cli": {
    "binaryName": "libramail",
    "resourcesPath": "/resources/",
    "extensions": [],
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0"
  }
}
