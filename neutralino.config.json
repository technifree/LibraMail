{
  "applicationId": "eu.libramail.app",
  "version": "0.4.1",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.open",
    "os.updateSpawnedProcess",
    "os.spawnProcess",
    "os.showSaveDialog",
    "os.showOpenDialog",
    "window.*",
    "storage.*",
    "filesystem.readFile",
    "filesystem.readBinaryFile",
    "filesystem.writeFile",
    "filesystem.createDirectory",
    "filesystem.writeBinaryFile",
    "filesystem.getStats"
  ],
  "modes": {
    "window": {
      "title": "LibraMail 0.4.1",
      "width": 1440,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "exitProcessOnClose": false,
      "icon": "/resources/icons/appIcon.png"
    }
  },
  "cli": {
    "binaryName": "libramail",
    "resourcesPath": "/resources/",
    "extensions": [],
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0"
  },
  "applicationName": "LibraMail",
  "applicationIcon": "resources/icons/appIcon.png",
  "author": "Vincent (technifree.com)",
  "description": "LibraMail - client de messagerie et planning portable",
  "copyright": "Copyright © Vincent (technifree.com)"
}
